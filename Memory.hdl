/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O.
 */

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux4Way(in=load, sel=address[13..14], a=loadRam0, b=loadRam1, c=loadScr, d=loadKey);
    Or(a=loadRam0, b=loadRam1, out=ramWrite);

    RAM16K(in=in, load=ramWrite, address=address[0..13], out=ramData);
    Screen(in=in, load=loadScr, address=address[0..12], out=scrData);
    Keyboard(out=keyData);

    Mux4Way16(a=ramData, b=ramData, c=scrData, d=keyData, sel=address[13..14], out=out);
}
